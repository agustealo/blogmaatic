{
  "name": "blogmaatic",
  "private": true,
  "version": "0.12.0",
  "description": "Publication automation control plane, local runtime, operator API, and Control Room",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run build && npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm test",
    "dev:control-room": "npm run dev --workspace @blogmaatic/control-room",
    "runtime:init": "npm run build --workspace @blogmaatic/runtime && node apps/runtime/dist/cli.js init",
    "runtime:start": "npm run build && node apps/runtime/dist/cli.js start",
    "runtime:token": "npm run build --workspace @blogmaatic/runtime && node apps/runtime/dist/cli.js token",
    "product:screenshots": "node scripts/capture-product-screenshots.mjs",
    "distribution:stage": "node scripts/build-distribution.mjs",
    "distribution:smoke": "node scripts/smoke-distribution.mjs",
    "distribution:native": "node scripts/build-native-package.mjs",
    "distribution:native:smoke": "node scripts/smoke-native-package.mjs",
    "release:validate": "node scripts/validate-release.mjs",
    "release:validate:contract": "node scripts/validate-release.mjs --contract-only",
    "release:metadata": "node scripts/generate-release-metadata.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "7.0.2"
  }
}
