{
  "name": "blogmaatic",
  "private": true,
  "version": "0.9.0",
  "description": "Publication automation control plane, operator API, and Control Room",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run build && npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm test",
    "dev:control-room": "npm run dev --workspace @blogmaatic/control-room"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "7.0.2"
  }
}
